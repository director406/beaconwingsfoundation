rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Volunteer applications — anyone can submit; only signed-in users can
    // read/update (app-layer admin check gates the dashboard UI itself, but
    // this stops anonymous direct-API access to applicants' personal data).
    match /volunteers/{id} {
      allow create: if true;
      allow read, update: if request.auth != null;
      allow delete: if false;
    }

    // Contact messages — anyone can submit; only signed-in users can read/update.
    match /contact/{id} {
      allow create: if true;
      allow read, update: if request.auth != null;
      allow delete: if false;
    }

    // User profiles (created on signup) — a user may only read/write their own doc.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Check-ins — public read so every volunteer sees the community feed;
    // anyone authenticated via the app can create; no edits or deletes
    match /checkins/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
